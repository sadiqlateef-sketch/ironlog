<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen food widget (NutritionWidgetProvider). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_nutrition_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6141414"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_nutrition_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food today"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_nutrition_line1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Nothing logged yet"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_nutrition_line2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_nutrition_log"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Log food"
        android:textAllCaps="false" />
</LinearLayout>
