<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ ignores allowBackup for phone-to-phone transfers, so this says the
  same thing explicitly: nothing (sign-in tokens, cached workouts) leaves the
  phone in a cloud backup or a device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
