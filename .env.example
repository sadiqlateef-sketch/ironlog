# Copy to .env.local and fill in from Supabase Dashboard > Project Settings > API
# (or from `npx supabase start` output when running locally).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The public "publishable" key (older projects call it the "anon" key).
# Safe to ship in the app because Row Level Security protects every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
